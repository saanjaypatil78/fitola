{
  "meta": {
    "name": "FitLens Design Tokens",
    "version": "1.0.0",
    "grid": "8pt"
  },
  "color": {
    "primary": {"500": "#14B8A6", "600": "#0D9488", "700": "#0F766E"},
    "secondary": {"500": "#FF7A59", "600": "#F97316"},
    "neutral": {"0": "#FFFFFF", "50": "#F7F9FA", "100": "#EEF2F4", "700": "#334155", "900": "#212121"},
